<!DOCTYPE html>
<html lang="zh" dir="auto" data-theme="auto">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,shrink-to-fit=no">
<meta name="robots" content="index, follow">
<title>Leeeezy's Studio</title>
<meta name="keywords" content="geekegret,RV1106,嵌入式,AIoT,工作室">
<meta name="description" content="geekegret 的工作室 —— 探索嵌入式与 AIoT 的无限可能。">
<meta name="author" content="geekegret">
<link rel="icon" href="/assets/avatar.png">
<meta name="theme-color" content="#fff7e2">
<style>
:root {
  --gap: 24px;
  --content-gap: 20px;
  --nav-width: 1024px;
  --main-width: 720px;
  --header-height: 60px;
  --footer-height: 78px;
  --radius: 8px;
}
:root {
  --theme: rgb(250, 249, 245);
  --entry: rgb(245, 244, 237);
  --primary: rgb(34, 34, 34);
  --secondary: rgb(108, 108, 108);
  --tertiary: rgb(233, 230, 220);
  --content: rgb(61, 57, 41);
  --code-block-bg: rgb(34, 36, 54);
  --code-bg: rgb(245, 244, 237);
  --border: rgb(176, 174, 165);
  color-scheme: light;
}
@media (prefers-color-scheme: dark) {
  :root {
    --theme: rgb(38, 38, 36);
    --entry: rgb(48, 48, 46);
    --primary: rgb(250, 249, 245);
    --secondary: rgb(183, 181, 169);
    --tertiary: rgb(48, 48, 46);
    --content: rgb(176, 174, 165);
    --code-block-bg: rgb(31, 30, 29);
    --code-bg: rgb(31, 30, 29);
    --border: rgb(82, 81, 74);
    color-scheme: dark;
  }
}
:root.dark {
  --theme: rgb(38, 38, 36);
  --entry: rgb(48, 48, 46);
  --primary: rgb(250, 249, 245);
  --secondary: rgb(183, 181, 169);
  --tertiary: rgb(48, 48, 46);
  --content: rgb(176, 174, 165);
  --code-block-bg: rgb(31, 30, 29);
  --code-bg: rgb(31, 30, 29);
  --border: rgb(82, 81, 74);
  color-scheme: dark;
}

*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

html { -webkit-font-smoothing: antialiased; scroll-behavior: smooth; background: var(--theme); }
body {
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Noto Sans SC", "PingFang SC", "Microsoft YaHei", "Helvetica Neue", sans-serif;
  font-size: 16px;
  line-height: 1.6;
  color: var(--primary);
  background: transparent;
  transition: background-color .3s ease, color .3s ease;
  min-height: 100vh;
}

body, .main, .footer, .header, .nav, .logo, #menu, .social-icons, .top-link {
  transition: background-color .3s ease, color .3s ease, border-color .3s ease, box-shadow .3s ease;
}

a { color: var(--primary); text-decoration: none; transition: color .2s ease; }
a:hover { color: #1a73e8; text-decoration: underline; }

/* Header */
.header { max-width: var(--nav-width); margin: 0 auto; padding: 0 var(--gap); height: var(--header-height); display: flex; align-items: center; position: sticky; top: 0; z-index: 10; background: var(--theme); border-bottom: 1px solid var(--border); }
.nav { display: flex; align-items: center; justify-content: space-between; width: 100%; flex-wrap: wrap; }
.logo { display: flex; align-items: center; gap: 8px; }
.logo a { font-size: 1.3em; font-weight: 700; color: var(--primary); text-decoration: none; }
.logo a:hover { color: #1a73e8; }

#menu { display: flex; list-style: none; gap: 4px; overflow-x: auto; padding: 0; }
#menu li a {
  display: block; padding: 6px 14px; border-radius: var(--radius);
  color: var(--secondary); font-size: .95em; font-weight: 500; text-decoration: none;
  transition: all .2s ease; white-space: nowrap;
}
#menu li a:hover, #menu li a.active { color: var(--primary); background: var(--entry); text-decoration: none; }

/* Main */
.main { max-width: var(--main-width); margin: 0 auto; padding: var(--gap); min-height: calc(100vh - var(--header-height) - var(--footer-height) - 40px); }

/* Profile */
.profile { margin-top: 40px; }
.profile_inner { text-align: center; padding: 40px var(--gap); background: var(--entry); border-radius: var(--radius); border: 1px solid var(--border); box-shadow: 0 2px 20px rgba(0,0,0,.04); }
.profile_inner img {
  width: 150px; height: auto; margin-bottom: 20px;
  transition: transform .3s ease;
}
.profile_inner img:hover { transform: scale(1.05); }
.profile_inner h1 { font-size: 2em; margin-bottom: 8px; font-weight: 700; }
.profile_inner span { color: var(--secondary); font-size: 1.05em; display: block; margin-bottom: 24px; }

.social-icons { display: flex; justify-content: center; gap: 14px; flex-wrap: wrap; }
.social-icons a {
  display: flex; align-items: center; justify-content: center;
  width: 42px; height: 42px; border-radius: 50%;
  border: 1px solid var(--border); color: var(--secondary);
  transition: all .2s ease;
}
.social-icons a:hover { color: #1a73e8; border-color: #1a73e8; transform: translateY(-2px); text-decoration: none; }
.social-icons svg { width: 20px; height: 20px; }

/* Posts section */
.posts-section { margin-top: 40px; }
.posts-section h2 { font-size: 1.5em; margin-bottom: 20px; color: var(--primary); }
.entry-list { display: flex; flex-direction: column; gap: 12px; }
.entry-item {
  display: flex; justify-content: space-between; align-items: center;
  padding: 16px 20px; background: var(--entry); border-radius: var(--radius);
  border: 1px solid var(--border); transition: all .2s ease;
}
.entry-item:hover { border-color: #1a73e8; transform: translateX(4px); }
.entry-item .entry-title { font-weight: 600; color: var(--primary); }
.entry-item .entry-date { color: var(--secondary); font-size: .85em; white-space: nowrap; margin-left: 12px; }
.entry-item .entry-tags { display: flex; gap: 6px; flex-wrap: wrap; }
.entry-item .entry-tags span {
  font-size: .75em; padding: 2px 8px; background: var(--tertiary);
  border-radius: 4px; color: var(--secondary);
}

/* Footer */
.footer { max-width: var(--main-width); margin: 0 auto; padding: 20px var(--gap); text-align: center; color: var(--secondary); font-size: .85em; border-top: 1px solid var(--border); }
.footer a { color: var(--secondary); }
.footer a:hover { color: #1a73e8; }
.footer span { display: block; }
.footer span + span { margin-top: 4px; }

/* Top link */
.top-link {
  visibility: hidden; opacity: 0; position: fixed; bottom: 30px; right: 30px;
  width: 40px; height: 40px; border-radius: 50%; background: var(--entry);
  border: 1px solid var(--border); display: flex; align-items: center; justify-content: center;
  cursor: pointer; z-index: 99; transition: all .3s ease;
}
.top-link:hover { border-color: #1a73e8; }
.top-link svg { width: 18px; height: 18px; fill: var(--secondary); }
.top-link.visible { visibility: visible; opacity: 1; }

/* Page content */
.page-content { max-width: 720px; margin: 0 auto; padding: 40px var(--gap); }
.page-content h1 { font-size: 2em; margin-bottom: 16px; }
.page-content h2 { font-size: 1.4em; margin: 28px 0 12px; padding-bottom: 6px; border-bottom: 1px solid var(--border); }
.page-content p { margin-bottom: 12px; color: var(--content); }
.page-content ul { padding-left: 20px; margin-bottom: 12px; }
.page-content li { color: var(--content); margin-bottom: 4px; }
.page-content .back-link { display: inline-block; margin-top: 24px; padding: 8px 16px; background: var(--entry); border: 1px solid var(--border); border-radius: var(--radius); font-size: .9em; }
.page-content .back-link:hover { border-color: #1a73e8; text-decoration: none; }

/* Tags cloud */
.tags-cloud { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 20px; }
.tag-item { padding: 6px 16px; background: var(--entry); border: 1px solid var(--border); border-radius: var(--radius); font-size: .9em; color: var(--secondary); transition: all .2s ease; cursor: pointer; }
.tag-item:hover { border-color: #1a73e8; color: #1a73e8; transform: translateY(-1px); }

/* Responsive */
@media (max-width: 600px) {
  .nav { flex-direction: column; gap: 10px; }
  .header { height: auto; padding: 12px var(--gap); }
  .profile_inner { padding: 30px 16px; }
  .profile_inner h1 { font-size: 1.6em; }
  .entry-item { flex-direction: column; align-items: flex-start; gap: 6px; }
  .entry-item .entry-date { margin-left: 0; }
}

/* Project cards */
.project-grid {
  display: flex; flex-direction: column; gap: 16px; margin-top: 24px;
}
.project-card {
  background: var(--entry); border-radius: var(--radius);
  border: 1px solid var(--border); overflow: hidden;
  transition: all .3s ease; cursor: pointer; display: flex; align-items: stretch;
  text-decoration: none; color: inherit;
}
.project-card:hover {
  border-color: #1a73e8; transform: translateX(4px);
  box-shadow: 0 4px 24px rgba(26,115,232,.1);
  text-decoration: none;
}
.project-card .card-img {
  width: 200px; min-height: 140px; object-fit: cover; display: block; flex-shrink: 0;
  background: var(--tertiary);
}
.project-card .card-img-placeholder {
  width: 160px; min-height: 140px; display: flex; align-items: center;
  justify-content: center; background: var(--tertiary); flex-shrink: 0;
  font-size: 2.5em; color: var(--secondary);
}
.project-card .card-body { padding: 16px 20px; }
.project-card .card-body h3 { font-size: 1.15em; margin-bottom: 6px; color: var(--primary); }
.project-card .card-body p { font-size: .9em; color: var(--secondary); margin-bottom: 10px; line-height: 1.5; }
.project-card .card-body .card-tags { display: flex; gap: 6px; flex-wrap: wrap; }
.project-card .card-body .card-tags span {
  font-size: .72em; padding: 2px 8px; background: var(--tertiary);
  border-radius: 4px; color: var(--secondary);
}

/* Project detail page */
.project-detail { max-width: 800px; margin: 0 auto; padding: 40px var(--gap); }
.project-detail h1 { font-size: 2em; margin-bottom: 8px; }
.project-detail .detail-meta { color: var(--secondary); font-size: .9em; margin-bottom: 20px; }
.project-detail .detail-img {
  width: 100%; max-height: 400px; object-fit: cover; border-radius: var(--radius);
  margin-bottom: 24px; border: 1px solid var(--border);
}
.project-detail .detail-img-placeholder {
  width: 100%; height: 260px; display: flex; align-items: center;
  justify-content: center; background: var(--tertiary); border-radius: var(--radius);
  font-size: 4em; color: var(--secondary); margin-bottom: 24px;
  border: 1px solid var(--border);
}
.project-detail h2 { font-size: 1.3em; margin: 24px 0 10px; padding-bottom: 6px; border-bottom: 1px solid var(--border); }
.project-detail p { margin-bottom: 12px; color: var(--content); line-height: 1.7; }
.project-detail ul, .project-detail ol { padding-left: 20px; margin-bottom: 12px; }
.project-detail li { color: var(--content); margin-bottom: 4px; line-height: 1.6; }
.project-detail .back-link { display: inline-block; margin-top: 24px; padding: 8px 16px; background: var(--entry); border: 1px solid var(--border); border-radius: var(--radius); font-size: .9em; }
.project-detail .back-link:hover { border-color: #1a73e8; text-decoration: none; }
.project-detail .detail-imgs { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 12px; margin: 16px 0; }
.project-detail .detail-imgs img {
  width: 100%; height: 180px; object-fit: cover; border-radius: var(--radius);
  border: 1px solid var(--border);
}
.project-detail .detail-imgs .detail-imgs-placeholder {
  width: 100%; height: 180px; display: flex; align-items: center;
  justify-content: center; background: var(--tertiary); border-radius: var(--radius);
  font-size: 2.5em; color: var(--secondary); border: 1px solid var(--border);
}
.project-detail code {
  background: var(--code-bg); padding: 2px 6px; border-radius: 4px;
  font-size: .9em; font-family: "SFMono-Regular", Consolas, "Liberation Mono", Menlo, monospace;
}
.project-detail pre {
  background: var(--code-block-bg); color: #e0e0e0; padding: 16px; border-radius: var(--radius);
  overflow-x: auto; margin-bottom: 16px; font-size: .9em; line-height: 1.5;
}
.project-detail pre code { background: none; padding: 0; color: inherit; }

/* Splash screen */
#splash {
  position: fixed; inset: 0; z-index: 9999;
  background: var(--theme);
  display: flex; align-items: center; justify-content: center;
  transition: opacity .6s ease, visibility .6s ease;
}
#splash.fade-out { opacity: 0; visibility: hidden; }
#splash img { width: 220px; height: auto; }

/* Animation */
@keyframes fadeIn {
  from { opacity: 0; transform: translateY(10px); }
  to { opacity: 1; transform: translateY(0); }
}
.profile_inner { animation: fadeIn .6s ease; }
.entry-item { animation: fadeIn .6s ease; }
.project-card { animation: fadeIn .6s ease; }

/* Responsive for project grid */
@media (max-width: 640px) {
  .project-card { flex-direction: column; }
  .project-card .card-img-placeholder,
  .project-card .card-img { width: 100%; height: 160px; min-height: auto; }
  .project-detail .detail-imgs { grid-template-columns: 1fr; }
}
</style>
</head>
