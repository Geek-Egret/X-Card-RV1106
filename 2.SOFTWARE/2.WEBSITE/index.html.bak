<script>
(function() {
  // Splash screen — only on first visit
  var splash = document.getElementById('splash');
  var html = document.documentElement;
  var hasVisited = sessionStorage.getItem('visited');

  // Set splash background to match theme
  var stored = localStorage.getItem('pref-theme');
  var isDark = stored ? stored === 'dark' : window.matchMedia('(prefers-color-scheme: dark)').matches;
  splash.style.background = isDark ? 'rgb(38,38,36)' : 'rgb(250,249,245)';

  if (hasVisited) {
    // Already visited this session, remove splash immediately
    splash.parentNode.removeChild(splash);
  } else {
    sessionStorage.setItem('visited', '1');
    // Fade out splash after page loads
    var fadeOut = function() {
      splash.classList.add('fade-out');
      setTimeout(function() {
        if (splash.parentNode) splash.parentNode.removeChild(splash);
      }, 700);
    };

    var loaded = false;
    window.addEventListener('load', function() { loaded = true; });
    setTimeout(function() {
      if (!loaded) window.addEventListener('load', fadeOut);
      fadeOut();
    }, 1500);

    splash.addEventListener('click', fadeOut);
  }

  // Init theme based on system preference
  (function() {
    var stored = localStorage.getItem('pref-theme');
    var dark = stored ? stored === 'dark' : window.matchMedia('(prefers-color-scheme: dark)').matches;
    if (dark) document.documentElement.classList.add('dark');
  })();

  // Particle canvas background
  (function() {
    var canvas = document.createElement('canvas');
    canvas.id = 'particles';
    canvas.style.cssText = 'position:fixed;top:0;left:0;width:100%;height:100%;z-index:-1;pointer-events:none';
    document.body.insertBefore(canvas, document.body.firstChild);
    var ctx = canvas.getContext('2d');
    var particles = [];
    var w, h;
    var mx = -1000, my = -1000;
    function resize() {
      w = canvas.width = window.innerWidth;
      h = canvas.height = window.innerHeight;
    }
    resize();
    window.addEventListener('resize', resize);
    document.addEventListener('mousemove', function(e) { mx = e.clientX; my = e.clientY; });
    document.addEventListener('mouseleave', function() { mx = -1000; my = -1000; });

    var count = Math.min(160, Math.floor((w * h) / 5000));
    for (var i = 0; i < count; i++) {
      particles.push({
        x: Math.random() * w,
        y: Math.random() * h,
        bx: Math.random() * w,
        by: Math.random() * h,
        r: Math.random() * 2 + 0.5,
        vx: (Math.random() - 0.5) * 0.3,
        vy: (Math.random() - 0.5) * 0.3,
        o: Math.random() * 0.5 + 0.3
      });
    }

    function draw() {
      ctx.clearRect(0, 0, w, h);
      var isDark = document.documentElement.classList.contains('dark');
      var color = isDark ? '255,255,255' : '100,100,120';
      for (var i = 0; i < particles.length; i++) {
        var p = particles[i];
        // Base movement
        p.bx += p.vx;
        p.by += p.vy;
        if (p.bx < 0) p.bx = w;
        if (p.bx > w) p.bx = 0;
        if (p.by < 0) p.by = h;
        if (p.by > h) p.by = 0;
        // Repel from mouse
        var dx = p.bx - mx;
        var dy = p.by - my;
        var dist = Math.sqrt(dx * dx + dy * dy);
        if (dist < 100 && mx > 0) {
          var force = (100 - dist) / 100;
          p.x = p.bx + (dx / dist) * force * 15;
          p.y = p.by + (dy / dist) * force * 15;
        } else {
          p.x += (p.bx - p.x) * 0.05;
          p.y += (p.by - p.y) * 0.05;
        }
        ctx.beginPath();
        ctx.arc(p.x, p.y, p.r, 0, Math.PI * 2);
        ctx.fillStyle = 'rgba(' + color + ',' + p.o + ')';
        ctx.fill();
      }
      for (var i = 0; i < particles.length; i++) {
        for (var j = i + 1; j < particles.length; j++) {
          var dx = particles[i].x - particles[j].x;
          var dy = particles[i].y - particles[j].y;
          var dist = Math.sqrt(dx * dx + dy * dy);
          if (dist < 120) {
            ctx.beginPath();
            ctx.moveTo(particles[i].x, particles[i].y);
            ctx.lineTo(particles[j].x, particles[j].y);
            ctx.strokeStyle = 'rgba(' + color + ',' + (0.08 * (1 - dist / 120)) + ')';
            ctx.lineWidth = 0.5;
            ctx.stroke();
          }
        }
      }
      requestAnimationFrame(draw);
    }
    draw();
  })();

  // Top link
  var topLink = document.getElementById('top-link');
  window.onscroll = function() {
    if (document.body.scrollTop > 800 || document.documentElement.scrollTop > 800) {
      topLink.classList.add('visible');
    } else {
      topLink.classList.remove('visible');
    }
  };

  // Menu scroll position persistence
  var menu = document.getElementById('menu');
  if (menu) {
    var saved = sessionStorage.getItem('menu-scroll-position');
    if (saved) menu.scrollLeft = parseInt(saved, 10);
    menu.addEventListener('scroll', function() {
      sessionStorage.setItem('menu-scroll-position', menu.scrollLeft);
    });
  }
})();
</script>

<script>
// SPA-style page loading
document.addEventListener('click', function(e) {
  var link = e.target.closest('a');
  if (!link) return;
  var href = link.getAttribute('href');
  if (!href || href.startsWith('http') || href.startsWith('#') || href.startsWith('mailto:') || link.target === '_blank') return;

  e.preventDefault();
  var path = href.replace(/\/$/, '') || '/';

  // Update active menu
  document.querySelectorAll('#menu a').forEach(function(a) {
    a.classList.toggle('active', a.getAttribute('href') === href);
  });

  // Simple page routing
  var main = document.querySelector('.main');
  if (path === '/') {
    window.history.pushState({page:'home'}, '', '/');
    location.reload();
  } else {
    window.history.pushState({page:path}, '', path);
    loadPage(path, main);
  }
});

function loadPage(path, container) {
  fetch(path + '.html')
    .then(function(res) {
      if (!res.ok) throw new Error('404');
      return res.text();
    })
    .then(function(html) {
      container.innerHTML = html;
    })
    .catch(function() {
      container.innerHTML = '<div class="page-content"><h1>404</h1><p>页面未找到。</p><a href="/" class="back-link">← 返回首页</a></div>';
    });
}

// Handle browser back/forward
window.addEventListener('popstate', function(e) {
  if (e.state && e.state.page) {
    var path = e.state.page;
    var main = document.querySelector('.main');
    if (path === 'home') {
      location.reload();
    } else {
      document.querySelectorAll('#menu a').forEach(function(a) {
        a.classList.toggle('active', a.getAttribute('href') === path);
      });
      loadPage(path, main);
    }
  }
});
</script>
</body>
</html>
